{
  "name": "dsh-subagent-model-routing",
  "version": "1.3.0",
  "description": "Difficulty-aware model and reasoning-effort routing for DeepSeek Harness subagents, with a settings card.",
  "type": "module",
  "main": "index.js",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "README.md",
    "README-zh.md",
    "LICENSE"
  ],
  "scripts": {
    "test": "node --test test/host.test.mjs"
  },
  "keywords": [
    "deepseek-harness",
    "dsh",
    "cordis",
    "plugin",
    "subagent",
    "model-routing",
    "reasoning-effort",
    "agent"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-connection",
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-runtime",
        "@deepseek-ai/dsh-client-ui-settings",
        "@deepseek-ai/dsh-api-remotes"
      ]
    }
  },
  "author": "guangjun-super",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/guangjun-super/dsh-subagent-model-routing.git"
  },
  "bugs": {
    "url": "https://github.com/guangjun-super/dsh-subagent-model-routing/issues"
  },
  "license": "MIT"
}
